
<Window xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:ConfigForge.ViewModels"
        xmlns:model="using:ConfigForge.Models"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ConfigForge.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ConfigForge"
        MinWidth="900"
        MinHeight="600"
        Background="#111318"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="52,*">

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="#191C23"
                BorderBrush="#2A2E38"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="220,*,Auto">

                <TextBlock Grid.Column="0"
                           Text="◆ ConfigForge"
                           Foreground="#E5E7EB"
                           FontSize="19"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="18,0"/>

                <TextBlock Grid.Column="1"
                           Text="Universal Configuration Editor"
                           Foreground="#777F90"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="v0.1.0"
                           Foreground="#777F90"
                           VerticalAlignment="Center"
                           Margin="18,0"/>

            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1"
              ColumnDefinitions="220,*,*">

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Background="#191C23"
                    BorderBrush="#2A2E38"
                    BorderThickness="0,0,1,0"
                    Padding="14">

                <StackPanel Spacing="12">

                    <TextBlock Text="CONFIGURATIONS"
                               Foreground="#777F90"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <Button Content="+ Import configuration"
                            Click="ImportButton_Click"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="Save"
                            Click="SaveButton_Click"
                            HorizontalAlignment="Stretch"/>

                    <Border Background="#252A35"
                            CornerRadius="5"
                            Padding="10">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Automatic mode"
                                       Foreground="#E5E7EB"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Types are detected automatically"
                                       Foreground="#858DA0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="TOML parser"
                                       Foreground="#8BC98B"
                                       FontSize="11"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- CENTER PANEL -->
            <Grid Grid.Column="1"
                  RowDefinitions="48,*"
                  ColumnDefinitions="*,*">

                <Border Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="#191C23"
                        BorderBrush="#2A2E38"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">

                    <TextBlock Text="Visual editor"
                               Foreground="#E5E7EB"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- CONFIGURATION TREE -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="12"
                        BorderBrush="#2A2E38"
                        BorderThickness="0,0,1,0">

                    <TreeView ItemsSource="{Binding ConfigNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              Background="Transparent">

                        <TreeView.DataTemplates>

                            <TreeDataTemplate DataType="model:ConfigNode"
                                              ItemsSource="{Binding Children}">

                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#E5E7EB"/>

                                    <TextBlock Text="{Binding Value}"
                                               Foreground="#8BC98B"/>

                                </StackPanel>

                            </TreeDataTemplate>

                        </TreeView.DataTemplates>

                    </TreeView>
                </Border>

                <!-- PROPERTY EDITOR -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Padding="16">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Spacing="12">

                            <TextBlock Text="Property editor"
                                       Foreground="#E5E7EB"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding SelectedNode.Name}"
                                       Foreground="#8BC98B"
                                       FontSize="14"/>

                            <!-- ARRAY EDITOR -->

                            <TextBlock Text="Array"
                                       Foreground="#858DA0"
                                       IsVisible="{Binding IsArray}"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding IsArray}">

                                <Button Content="+ Add element"
                                        Command="{Binding AddArrayElementCommand}"/>

                                <Button Content="- Remove selected"
                                        Command="{Binding RemoveArrayElementCommand}"/>

                            </StackPanel>

                            <TextBlock Text="Select an element in the tree to edit it."
                                       Foreground="#858DA0"
                                       FontSize="12"
                                       IsVisible="{Binding IsArray}"/>

                            <!-- BOOLEAN EDITOR -->

                            <TextBlock Text="Boolean"
                                       Foreground="#858DA0"
                                       IsVisible="{Binding IsBoolean}"/>

                            <CheckBox Content="Enabled"
                                      IsChecked="{Binding SelectedBooleanValue, Mode=TwoWay}"
                                      IsVisible="{Binding IsBoolean}"
                                      Foreground="#E5E7EB"/>

                            <!-- NUMBER EDITOR -->

                            <TextBlock Text="Number"
                                       Foreground="#858DA0"
                                       IsVisible="{Binding IsNumberInput}"/>

                            <TextBox Text="{Binding SelectedTextValue, Mode=TwoWay}"
                                     IsVisible="{Binding IsNumberInput}"
                                     Background="#191C23"
                                     Foreground="#E5E7EB"
                                     BorderBrush="#343A46"/>

                            <!-- SLIDER EDITOR -->

                            <StackPanel Spacing="8"
                                        IsVisible="{Binding IsSlider}">

                                <TextBlock Text="Value range"
                                           Foreground="#858DA0"
                                           FontSize="12"/>

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="{Binding SliderMinimum}"
                                               Foreground="#9CA3AF"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SliderMaximum}"
                                               Foreground="#9CA3AF"/>

                                </Grid>

                                <Slider Minimum="{Binding SliderMinimum}"
                                        Maximum="{Binding SliderMaximum}"
                                        SmallChange="{Binding SliderStep}"
                                        Value="{Binding SelectedSliderValue, Mode=TwoWay}"/>

                                <TextBlock Text="{Binding SelectedSliderValue}"
                                           Foreground="#8BC98B"
                                           HorizontalAlignment="Center"
                                           FontSize="16"/>

                            </StackPanel>

                            <!-- STRING EDITOR -->

                            <TextBlock Text="Text"
                                       Foreground="#858DA0"
                                       IsVisible="{Binding IsText}"/>

                            <TextBox Text="{Binding SelectedTextValue, Mode=TwoWay}"
                                     IsVisible="{Binding IsText}"
                                     Background="#191C23"
                                     Foreground="#E5E7EB"
                                     BorderBrush="#343A46"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>

            <!-- RIGHT PANEL: SOURCE -->
            <Grid Grid.Column="2"
                  RowDefinitions="48,*,100">

                <Border Grid.Row="0"
                        Background="#191C23"
                        BorderBrush="#2A2E38"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">

                    <TextBlock Text="Source"
                               Foreground="#E5E7EB"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Border>

                <Border Grid.Row="1"
                        Padding="10">

                    <TextBox Text="{Binding SourceCode, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="monospace"
                             Background="#15181F"
                             Foreground="#C9D1D9"
                             BorderThickness="0"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"/>

                </Border>

                <Border Grid.Row="2"
                        Background="#191C23"
                        BorderBrush="#2A2E38"
                        BorderThickness="0,1,0,0"
                        Padding="12">

                    <StackPanel Spacing="6">

                        <TextBlock Text="DIAGNOSTICS"
                                   Foreground="#777F90"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#8BC98B"
                                   FontSize="12"/>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</Window>
